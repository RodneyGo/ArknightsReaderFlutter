# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock

# IDE
.idea/
*.iml
.vscode/

# android/ and ios/ ARE tracked (they hold the manifest, build.gradle, signing,
# etc.); their own .gitignore files + the build/ rule above exclude generated
# bits. Desktop/web targets aren't used, so keep them out.
/linux/
/macos/
/windows/
/web/

# Misc
.DS_Store
# Windows shortcuts (e.g. a desktop shortcut to the built APK)
*.lnk

